<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://qconsulting.ca/fo3/ModConfig5.0.xsd">
  <moduleName>Faster Spaceship Docking Rotation Reloaded</moduleName>
  <installSteps order="Explicit">
    <installStep name="Choose docking rotation speed">
      <optionalFileGroups order="Explicit">
        <group name="Speed" type="SelectExactlyOne">
          <plugins order="Explicit">
            <plugin name="Instant">
              <description>Instant docking rotation</description>
              <files>
                <folder source="Instant" destination="Faster Spaceship Docking Rotation Reloaded - Instant" priority="0" />
              </files>
              <typeDescriptor>
                <type name="Optional" />
              </typeDescriptor>
            </plugin>
            <plugin name="10x">
              <description>10x faster docking rotation</description>
              <files>
                <folder source="10x" destination="Faster Spaceship Docking Rotation Reloaded - 10x" priority="0" />
              </files>
              <typeDescriptor>
                <type name="Optional" />
              </typeDescriptor>
            </plugin>
          </plugins>
        </group>
      </optionalFileGroups>
    </installStep>
  </installSteps>
</config>
